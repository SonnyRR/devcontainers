# DevContainer conventions
# Date: 15/09/2026

# Remove the line below if you want to inherit .editorconfig settings from higher directories
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4

[*.{json,xml,yml,yaml}]
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[**/Dockerfile]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.fish]
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true

[.bashrc]
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
