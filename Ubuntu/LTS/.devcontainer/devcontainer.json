{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "ubuntu-lts",
  "shutdownAction": "stopContainer",
  "image": "docker.io/vkotzsev/ubuntu-lts:latest",
  "remoteUser": "developer",
  "mounts": [
    "source=dev-ubuntu-fish-history-${localWorkspaceFolderBasename},target=/home/developer/.local/share/fish,type=volume",
    "source=dev-ubuntu-xdg-cache-${localWorkspaceFolderBasename},target=/home/developer/.cache,type=volume",
    "source=dev-claude-config,target=/home/developer/.claude,type=volume",
    "source=dev-gh-config,target=/home/developer/.config/gh,type=volume",
    "source=dev-ubuntu-azure-config,target=/home/developer/.azure,type=volume",
    "source=dev-nuget-packages,target=/home/developer/.nuget/packages,type=volume",
    "source=dev-npm-cache,target=/home/developer/.npm,type=volume",
    // Default: rootful Docker at /var/run/docker.sock. For rootless Docker on Linux,
    // change only this source to the host's socket path (e.g. /run/user/1010/docker.sock).
    // Keep the target and the onCreateCommand/postStartCommand socket-init hooks unchanged.
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "init": true,
  "onCreateCommand": "sudo /usr/local/bin/docker-socket-init.sh",
  "postStartCommand": "sudo /usr/local/bin/docker-socket-init.sh",
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "containerEnv": {
    // Rootless Docker on Linux: Ryuk & other Testcontainers helper containers need the
    // host-side socket path (without unix://). Uncomment & match the mount source above
    // locally; the default rootful socket needs no override.
    // "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE": "/run/user/1010/docker.sock",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": {
            "path": "/usr/bin/fish"
          }
        }
      },
      "extensions": [
        "editorconfig.editorconfig",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-playwright.playwright",
        "angular.ng-template",
        "github.vscode-pull-request-github"
      ]
    }
  }
}
