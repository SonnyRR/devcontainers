{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "opensuse-leap",
  "shutdownAction": "stopContainer",
  "image": "docker.io/vkotzsev/opensuse-leap:latest",
  "remoteUser": "developer",
  "mounts": [
    "source=dev-leap-fish-history-${localWorkspaceFolderBasename},target=/home/developer/.local/share/fish,type=volume",
    "source=dev-leap-xdg-cache-${localWorkspaceFolderBasename},target=/home/developer/.cache,type=volume",
    "source=dev-claude-config,target=/home/developer/.claude,type=volume",
    "source=dev-gh-config,target=/home/developer/.config/gh,type=volume",
    "source=dev-leap-azure-config,target=/home/developer/.azure,type=volume",
    "source=dev-nuget-packages,target=/home/developer/.nuget/packages,type=volume",
    "source=dev-npm-cache,target=/home/developer/.npm,type=volume",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "init": true,
  "onCreateCommand": "sudo /usr/local/bin/docker-socket-init.sh",
  "postStartCommand": "sudo /usr/local/bin/docker-socket-init.sh",
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": {
            "path": "/usr/bin/fish"
          }
        }
      },
      "extensions": [
        "editorconfig.editorconfig",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-playwright.playwright",
        "angular.ng-template",
        "github.vscode-pull-request-github"
      ]
    }
  }
}
