{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "opensuse-tumbleweed",
  "shutdownAction": "stopContainer",
  "image": "docker.io/<your-dockerhub-username>/opensuse-tumbleweed:latest",
  "remoteUser": "developer",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/developer/.gitconfig,type=bind,readonly",
    "source=dev-suse-fish-history-${devcontainerId},target=/home/developer/.local/share/fish,type=volume",
    "source=dev-suse-xdg-cache-${devcontainerId},target=/home/developer/.cache,type=volume",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postCreateCommand": "sudo /usr/local/bin/docker-socket-init.sh",
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": {
            "path": "/usr/bin/fish"
          }
        }
      },
      "extensions": [
        "editorconfig.editorconfig",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-playwright.playwright",
        "angular.ng-template",
        "github.vscode-pull-request-github"
      ]
    }
  }
}
